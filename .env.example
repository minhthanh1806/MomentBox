# Copy file này thành .env rồi điền key thật. KHÔNG commit file .env.
# Chỉ cần điền những dịch vụ bạn có. Khi 1 dịch vụ hết lượt, hệ thống tự chuyển sang dịch vụ tiếp theo.
# Thứ tự thử ảnh: Gemini -> OpenAI -> Cloudflare -> HuggingFace -> Pollinations

GEMINI_API_KEY=AIzaSy_your_gemini_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# Cloudflare Workers AI (có hạn mức miễn phí mỗi ngày)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face (token miễn phí, hạn mức hạn chế)
HF_TOKEN=
